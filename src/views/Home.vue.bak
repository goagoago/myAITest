            <span class="hero-title__gradient">把高频任务做得更顺手</span>
          </h1>

              <span>立即开始</span>
            </button>
        </div>

        <div class="studio__meta">
          <span class="studio__count">{{ studioCountLabel }}</span>
          <FeatureCostBadge :feature-code="studioFeatureCode" strong />
          <button class="studio__ghost" type="button" @click="resetStudio">
            <RefreshCw :size="14" />
            <span>重置</span>
          </button>
        </div>
      </div>

      <div class="studio__shell">
        <div class="studio__chips">
          <button
            v-for="item in activeSuggestions"
            :key="item"
            type="button"
            class="studio__chip"
            @click="submitStudio(item)"
          >
            {{ item }}
          </button>
        </div>

        <div ref="studioTimeline" class="studio__messages">
          <article
            v-for="message in studioMessages"
            :key="message.id"
            class="message"
            :class="`message--${message.role}`"
          >
            <div class="message__meta">
              <span class="message__role">{{ message.role === 'assistant' ? 'AI' : '你' }}</span>
              <button
                v-if="message.role === 'user' && message.turnId"
                class="message__delete"
                type="button"
                @click="deleteTurn(message.turnId)"
              >
                <Trash2 :size="14" />
              </button>
            </div>

            <div class="message__body">
              <div class="message__attachments">
                <div
                  v-for="attachment in message.attachments"
                  :key="attachment.id"
                  class="message__attachment"
                  :class="`message__attachment--${attachment.kind}`"
                >
                  <component
                    :is="attachment.icon"
                    :size="18"
                    class="message__attachment-icon"
                    :class="`message__attachment-icon--${attachment.kind}`"
                  />
                  <div class="message__attachment-info">
                    <span class="message__attachment-name">{{ attachment.name }}</span>
                    <span v-if="attachment.size" class="message__attachment-size">{{ formatFileSize(attachment.size) }}</span>
                  </div>
                </div>
              </div>

              <div v-if="message.kind === 'image' && message.images?.length" class="message__image-result">
                <img
                  v-for="image in message.images"
                  :key="image.id"
                  :src="image.url"
                  alt="AI 生成图片"
                  class="message__generated-image"
                />
              </div>

              <div v-if="message.content" class="message__content" v-html="renderMarkdown(message.content)"></div>
            </div>
          </article>
        </div>

        <div v-if="pendingAttachments.length && currentMode === 'chat'" class="studio__pending">
          <div
            v-for="attachment in pendingAttachments"
            :key="attachment.id"
            class="studio__pending-item"
            :class="`studio__pending-item--${attachment.kind}`"
          >
            <component
              :is="attachment.icon"
              :size="20"
              class="studio__pending-icon"
              :class="`studio__pending-icon--${attachment.kind}`"
            />
            <span class="studio__pending-name">{{ attachment.name }}</span>
            <span class="studio__pending-size">{{ formatFileSize(attachment.size) }}</span>
            <button class="studio__pending-remove" type="button" @click="removeAttachment(attachment.id)">
              <X :size="14" />
            </button>
          </div>
        </div>

        <div class="studio__composer">
          <textarea
            v-model="composerInput"
            class="studio__input"
            rows="4"
            :placeholder="currentMode === 'image' ? '输入生图提示词' : '输入你的问题'"
            @keydown.enter.exact.prevent="submitStudio()"
          />

          <div class="studio__footer">
            <div class="studio__footer-left">
              <label v-if="currentMode === 'chat'" class="studio__upload">
                <input
                  ref="fileInput"
                  type="file"
                  multiple
                  accept="image/*,.txt,.md,.markdown,.csv,.json"
                  hidden
                  @change="handleFiles"
                />
                <Paperclip :size="16" />
                <span>附件</span>
              </label>
              <span class="studio__hint">
                {{ currentMode === 'chat' ? '支持图片和文本附件' : '切到聊天模式可上传附件' }}
              </span>
            </div>

            <button
              class="studio__submit"
              type="button"
              :disabled="studioBusy || (!composerInput.trim() && !(currentMode === 'chat' && pendingAttachments.length))"
              @click="submitStudio()"
            >
              <template v-if="studioBusy">
                <Loader2 :size="18" class="studio__spin" />
                <span>{{ currentMode === 'image' ? '生图中' : '生成中' }}</span>
              </template>
              <template v-else>
                <Send :size="18" />
                <span>{{ currentMode === 'image' ? '生成图片' : '发送' }}</span>
              </template>
            </button>
          </div>
        </div>
      </div>

      <p v-if="studioError" class="studio__error">{{ studioError }}</p>
    </section>

    <section class="tools tools--first">
      <div v-for="category in toolCategories" :key="category.id" class="tools__category">
        <div class="category-head" :data-tone="category.tone">
