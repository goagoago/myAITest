const createWelcomeMessage = () => ({
  id: 'welcome',
  role: 'assistant',
  kind: 'text',
  mode: 'chat',
  content: '直接问。',
  system: true,
  createdAt: Date.now(),
})

const historyKey = computed(() => `toolsbox-home-studio:${account.profile.value?.id || 'guest'}`)
const studioBusy = computed(() => chatLoading.value)
const studioFeatureCode = computed(() => 'ai-chat')
const studioCountLabel = computed(() => `${studioMessages.value.filter(item => !item.system).length} 条消息`)
const activeSuggestions = computed(() => chatSuggestions)

const renderMarkdown = (content) => marked.parse(content || '', { breaks: true })

const sanitizeMessages = (value) => {
  if (!Array.isArray(value)) return []
  const cutoff = Date.now() - CHAT_RETENTION_MS

  return value
    .filter(item => item && ['assistant', 'user'].includes(item.role))
    .filter(item => !item.system)
    .map(item => ({
      id: item.id || `msg-${Math.random().toString(36).slice(2)}`,
      role: item.role,
      mode: item.mode === 'image' ? 'image' : 'chat',
      kind: item.kind === 'image' ? 'image' : 'text',
      content: typeof item.content === 'string' ? item.content : '',
      turnId: item.turnId || '',
      createdAt: Number(item.createdAt) || Date.now(),
      images: Array.isArray(item.images)
        ? item.images
            .filter(image => image?.url)
            .map(image => ({
              id: image.id || `img-${Math.random().toString(36).slice(2)}`,
              url: image.url,
              revisedPrompt: image.revisedPrompt || '',
            }))
        : [],
    }))
    .filter(item => item.createdAt >= cutoff)
}

const applyMessages = (messages) => {
  studioMessages.value = messages.length ? messages : [createWelcomeMessage()]
}

const persistMessages = () => {
  if (typeof window === 'undefined') return
  const messages = sanitizeMessages(studioMessages.value)
  if (messages.length) {
    window.localStorage.setItem(historyKey.value, JSON.stringify(messages))
  } else {
    window.localStorage.removeItem(historyKey.value)
  }
}

const loadMessages = () => {
  if (typeof window === 'undefined') return
  try {
    const raw = window.localStorage.getItem(historyKey.value)
    const parsed = raw ? JSON.parse(raw) : []
    applyMessages(sanitizeMessages(parsed))
  } catch {
    applyMessages([])
  }
}

watch(historyKey, () => {
  loadMessages()
}, { immediate: true })

watch(studioMessages, () => {
  persistMessages()
}, { deep: true })

watch(() => route.query.mode, (value) => {
  pendingAttachments.value = []
  studioError.value = ''
}

const deleteTurn = (turnId) => {
  if (!turnId) return
  applyMessages(sanitizeMessages(studioMessages.value.filter(item => item.turnId !== turnId)))
}

const removeAttachment = (id) => {
  pendingAttachments.value = pendingAttachments.value.filter(item => item.id !== id)
}

const readAsDataUrl = (file) => new Promise((resolve, reject) => {
  const reader = new FileReader()
  reader.onload = () => resolve(String(reader.result || ''))
  reader.onerror = () => reject(new Error(`读取 ${file.name} 失败`))
  reader.readAsDataURL(file)
})

const readAsText = (file) => new Promise((resolve, reject) => {
  const reader = new FileReader()
  reader.onload = () => resolve(String(reader.result || ''))
  reader.onerror = () => reject(new Error(`读取 ${file.name} 失败`))
  reader.readAsText(file, 'utf-8')
})

const readAsArrayBuffer = (file) => new Promise((resolve, reject) => {
  const reader = new FileReader()
  reader.onload = () => resolve(reader.result)
  reader.onerror = () => reject(new Error(`读取 ${file.name} 失败`))
  reader.readAsArrayBuffer(file)
})

const getFileIcon = (file) => {
  const type = file.type
  if (type.startsWith('image/')) return 'FileImage'
  if (type.includes('pdf')) return 'FileText'
  if (type.includes('word') || type.includes('document')) return 'FileText'
  if (type.includes('excel') || type.includes('sheet')) return 'FileSpreadsheet'
  if (type.includes('powerpoint') || type.includes('presentation')) return 'Presentation'
  if (type.includes('video')) return 'MonitorPlay'
  if (type.includes('audio')) return 'Music'
  if (type.includes('zip') || type.includes('rar')) return 'Archive'
  return 'File'
}

const getFileExtension = (filename) => {
  const match = filename.toLowerCase().match(/\.[^.]+$/)
  return match ? match[0] : ''
}

const getExtensionIcon = (ext) => {
  const icons = {
    '.pdf': 'FileText',
    '.doc': 'FileText',
    '.docx': 'FileText',
    '.xls': 'FileSpreadsheet',
    '.xlsx': 'FileSpreadsheet',
    '.ppt': 'FileText',
    '.pptx': 'FileText',
    '.zip': 'Archive',
    '.rar': 'Archive',
    '.mp3': 'Music',
    '.mp4': 'MonitorPlay',
    '.wav': 'Music',
    '.mov': 'MonitorPlay',
    '.webm': 'MonitorPlay',
    '.avi': 'MonitorPlay',
    '.wmv': 'MonitorPlay',
    '.gif': 'Image',
    '.png': 'Image',
    '.jpg': 'Image',
    '.jpeg': 'Image',
    '.webp': 'Image',
    '.svg': 'Image',
  }
  return icons[ext] || 'File'
}

const isTextFile = (file) => {
  if (file.type.startsWith('text/')) return true
  if (file.type.includes('json') || file.type.includes('xml') || file.type.includes('markdown') ||
      file.type.includes('csv') || file.type.includes('html') || file.type.includes('rtf')) {
    return true
  }
  const ext = getFileExtension(file.name)
  const extMap = {
    '.txt': true,
    '.md': true,
    '.markdown': true,
    '.csv': true,
    '.json': true,
    '.xml': true,
    '.html': true,
    '.htm': true,
    '.rtf': true,
  }
  return !!extMap[ext]
}

const formatFileSize = (bytes) => {
  if (bytes === 0) return '0 B'
  const k = 1024
  const sizes = ['B', 'KB', 'MB', 'GB']
  const i = Math.floor(Math.log(bytes) / Math.log(k))
  return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i]
}

const getMimeTypeClass = (type) => {
  if (type.startsWith('image/')) return 'mimeType-image'
  if (type.includes('pdf')) return 'mimeType-pdf'
  if (type.includes('word')) return 'mimeType-word'
  if (type.includes('excel')) return 'mimeType-excel'
  if (type.includes('powerpoint')) return 'mimeType-ppt'
  if (type.includes('video')) return 'mimeType-video'
  if (type.includes('audio')) return 'mimeType-audio'
  if (type.includes('zip')) return 'mimeType-archive'
  if (type.includes('json') || type.includes('xml') || type.includes('text')) return 'mimeType-code'
  return 'mimeType-default'
}

const handleFiles = async (event) => {
  studioError.value = ''
  const files = Array.from(event.target.files || [])
  event.target.value = ''

  if (!files.length) return

  const availableSlots = MAX_ATTACHMENTS - pendingAttachments.value.length
  if (availableSlots <= 0) {
    studioError.value = `最多上传 ${MAX_ATTACHMENTS} 个附件`
    return
  }

  const targets = files.slice(0, availableSlots)
  const nextAttachments = []

  for (const file of targets) {
    try {
      // 检查文件大小
      if (file.size > MAX_FILE_SIZE) {
        studioError.value = `${file.name} 大小超过 50MB 限制`
        return
      }

      if (file.type.startsWith('image/')) {
        const dataUrl = await readAsDataUrl(file)
        nextAttachments.push({
          id: `att-${Date.now()}-${Math.random().toString(36).slice(2)}`,
          kind: 'image',
          name: file.name,
          size: file.size,
          mimeType: file.type,
          previewUrl: dataUrl,
          dataUrl,
          icon: 'FileImage',
        })
        continue
      }

      if (isTextFile(file)) {
        let textContent
        if (file.size > TEXT_ATTACHMENT_LIMIT) {
          // 大文本文件只读取前部分
          const reader = new FileReader()
          textContent = new Promise((resolve) => {
            reader.onload = (e) => resolve(e.target.result.slice(0, TEXT_ATTACHMENT_LIMIT))
            reader.readAsText(file, 'utf-8')
          })
          textContent = await textContent
        } else {
          textContent = await readAsText(file)
        }
        nextAttachments.push({
          id: `att-${Date.now()}-${Math.random().toString(36).slice(2)}`,
          kind: 'text',
          name: file.name,
          size: file.size,
          mimeType: file.type,
          text: textContent,
          icon: getFileIcon(file),
        })
        continue
      }

      // 其他文件转为 base64
      const arrayBuffer = await readAsArrayBuffer(file)
      const base64 = btoa(String.fromCharCode(...new Uint8Array(arrayBuffer)))
      nextAttachments.push({
        id: `att-${Date.now()}-${Math.random().toString(36).slice(2)}`,
        kind: 'document',
        name: file.name,
        size: file.size,
        mimeType: file.type,
        base64,
        icon: getFileIcon(file),
        ext: getFileExtension(file.name),
      })
    } catch (error) {
      studioError.value = `读取 ${file.name} 失败: ${error.message}`
      return
    }
  }

  pendingAttachments.value = [...pendingAttachments.value, ...nextAttachments]
}

const onDragEnter = (e) => {
  e.preventDefault()
  e.stopPropagation()
}

const onDragOver = (e) => {
  e.preventDefault()
  e.stopPropagation()
}

const onDragLeave = (e) => {
  e.preventDefault()
  e.stopPropagation()
}

const onDrop = async (e) => {
  e.preventDefault()
  e.stopPropagation()
  const files = Array.from(e.dataTransfer.files || [])
  if (!files.length) return

  const availableSlots = MAX_ATTACHMENTS - pendingAttachments.value.length
  if (availableSlots <= 0) {
    studioError.value = `最多上传 ${MAX_ATTACHMENTS} 个附件`
    return
  }

  const targets = files.slice(0, availableSlots)
  const nextAttachments = []

  for (const file of targets) {
    try {
      // 检查文件大小
      if (file.size > MAX_FILE_SIZE) {
        studioError.value = `${file.name} 大小超过 50MB 限制`
        return
      }

      if (file.type.startsWith('image/')) {
        const dataUrl = await readAsDataUrl(file)
        nextAttachments.push({
          id: `att-${Date.now()}-${Math.random().toString(36).slice(2)}`,
          kind: 'image',
          name: file.name,
          size: file.size,
          mimeType: file.type,
          previewUrl: dataUrl,
          dataUrl,
          icon: 'FileImage',
        })
        continue
      }

      if (isTextFile(file)) {
        let textContent
        if (file.size > TEXT_ATTACHMENT_LIMIT) {
          const reader = new FileReader()
          textContent = new Promise((resolve) => {
            reader.onload = (e) => resolve(e.target.result.slice(0, TEXT_ATTACHMENT_LIMIT))
            reader.readAsText(file, 'utf-8')
          })
          textContent = await textContent
        } else {
          textContent = await readAsText(file)
        }
        nextAttachments.push({
          id: `att-${Date.now()}-${Math.random().toString(36).slice(2)}`,
          kind: 'text',
          name: file.name,
          size: file.size,
          mimeType: file.type,
          text: textContent,
          icon: getFileIcon(file),
        })
        continue
      }

      const arrayBuffer = await readAsArrayBuffer(file)
      const base64 = btoa(String.fromCharCode(...new Uint8Array(arrayBuffer)))
      nextAttachments.push({
        id: `att-${Date.now()}-${Math.random().toString(36).slice(2)}`,
        kind: 'document',
        name: file.name,
        size: file.size,
        mimeType: file.type,
        base64,
        icon: getFileIcon(file),
        ext: getFileExtension(file.name),
      })
    } catch (error) {
      studioError.value = `读取 ${file.name} 失败: ${error.message}`
      return
    }
  }

  pendingAttachments.value = [...pendingAttachments.value, ...nextAttachments]
}

const buildUserPayload = (content, attachments) => {
  const imageAttachments = attachments.filter(item => item.kind === 'image')
  const textAttachments = attachments.filter(item => item.kind === 'text')

  const textBlocks = []
  if (content) {
    textBlocks.push(content)
  }

  if (textAttachments.length) {
    textBlocks.push(textAttachments.map(item => `附件：${item.name}\n${item.text}`).join('\n\n'))
  }

  const textPayload = textBlocks.join('\n\n').trim()
  if (!imageAttachments.length) {
    return textPayload
  }

  return [
    {
      type: 'text',
      text: textPayload || '请结合附件图片处理。',
    },
    ...imageAttachments.map(item => ({
      type: 'image_url',
      image_url: {
        url: item.dataUrl,
      },
    })),
  ]
}

const toDisplayAttachments = (attachments) => attachments.map(item => ({
  id: item.id,
  kind: item.kind,
  name: item.name,
  previewUrl: item.previewUrl || '',
}))

const submitChat = async (content, attachments = []) => {
  const history = studioMessages.value
    .filter(item => item.mode === 'chat' && item.kind === 'text' && item.content)
    .map(item => ({
      role: item.role,
      content: item.payloadContent || item.content,
    }))

  const turnId = `turn-${Date.now()}-${turnSeed.value++}`
  const createdAt = Date.now()
  const payloadContent = buildUserPayload(content, attachments)
  const userMessage = {
    id: `user-${turnSeed.value++}`,
    role: 'user',
    mode: 'chat',
    kind: 'text',
    content,
    payloadContent,
    attachments: toDisplayAttachments(attachments),
    turnId,
    createdAt,
  }
  const assistantMessage = {
    id: `assistant-${turnSeed.value++}`,
    role: 'assistant',
    mode: 'chat',
    kind: 'text',
    content: '',
    turnId,
    createdAt,
  }

  studioMessages.value = [...studioMessages.value, userMessage, assistantMessage]
  composerInput.value = ''
  pendingAttachments.value = []
  studioError.value = ''
  syncTimeline()

  try {
    await sendMessageStream([
      {
        role: 'system',
        content: '你是 Tools Box 首页 AI 助手。请用中文回答，语气专业直接，优先给出可执行建议，适合处理旅行规划、文案润色、工作整理、翻译和头脑风暴。',
      },
      ...history,
      {
        role: 'user',
        content: payloadContent,
      },
    ], (_, fullText) => {
      assistantMessage.content = fullText
      syncTimeline()
    })
  } catch (error) {
    assistantMessage.content = error?.message === '请先登录后再使用该功能'
      ? '登录后即可使用。'
      : (error?.message || '这次没有顺利返回结果。')
    studioError.value = assistantMessage.content
  }
}

const submitStudio = async (preset = '') => {
  const content = (preset || composerInput.value).trim()
  if (!content && !pendingAttachments.value.length) return

  await submitChat(content, pendingAttachments.value)
}
</script>

<template>
  <div class="home">
    <section class="hero-shell">
      <div class="hero-atmosphere hero-atmosphere--top"></div>
      <div class="hero-atmosphere hero-atmosphere--bottom"></div>
